params {
    // Boilerplate options
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = false

    fasta = null
    metadata = null
    outdir = "output"

    mafft = false
    aliases_file = "data/aliases.csv"
    trim_start = null
    trim_end = null
    adar_mode = "exclude_tc"
    seed = 42
    exclude_file = "data/exclude_identity.txt"
    exclude_quality = "data/exclude_quality.txt"
    outlier_file = null
    outlier_removal_threshold = null
    model = null
    min_date = null
    beast_template = "templates/GTR_EGC.template.xml"
    
    wf {
          example_cmd = []
          agent = null
          container = ""
          container_version = ""
        }
}


manifest {
    name            = 'pekarj/bdbv-pipeline-temp'
    author          = 'Jonathan Pekar'
    homePage        = 'https://github.com/pekarj/bdbv-pipeline-temp/'
    description     = 'Automated pipeline for downloading, cleaning, and building maximum-likelihood phylogenies from Bundibugyo ebolavirus (BDBV) genome sequences hosted on Pathoplexus.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=20.10.0'
    version         = '1.0.0'
}

executor {
    $local {
        cpus = 8
        memory = "8 GB"
    }
}

// used by default for "standard" (docker) and singularity profiles,
// other profiles may override.
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
}


profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }


    conda {
        conda.enabled = true
    }

    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }
}


timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/trace.txt"
}

env {
	PYTHONNOUSERSITE = 1
}
