params {
    // Boilerplate options
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = false

    // Inputs (leave fasta unset to download from Pathoplexus)
    fasta = null
    metadata = null
    outdir = "output"
    run_name = new java.util.Date().format('yyyyMMdd')
    prefix = "bdbv_${params.run_name}"
    organism = "ebola-bdbv"
    scope = "drc"
    max_date = null
    pathoplexus_filters = null
    aliases_file = "${projectDir}/data/aliases.csv"
    exclude_file = "${projectDir}/data/exclude.txt"
    mask_sites = null
    mask_sites_file = "${projectDir}/data/mask_sites.txt"
    exclude_pending = "${projectDir}/data/exclude_pending.txt"

    // INRB linelist (Excel), optional: adds duplicate resolution and mismatch checks to the metadata quality report
    linelist = null
    hz_lookup = "${projectDir}/data/health_area_zone_province_slim.csv"

    // Slack notification when the run finishes. Prefer the environment variable so the URL is not on the command line
    slack_webhook = System.getenv('SLACK_WEBHOOK_URL') ?: null

    // Tree building
    mafft = false
    trim_start = 47
    trim_end = 18851
    min_date = null
    model = null
    seed = 42
    // Which Docker image platform to run: "auto" (amd64 on Apple Silicon Macs, where it runs much faster
    // under Rosetta than the native arm64 build; native everywhere else), "native", "linux/amd64" or "linux/arm64"
    container_platform = "auto"
    adar_mode = "mask"

    // Review point 1: outliers
    outlier_removal_threshold = null
    outlier_file = null
    resume_from = null

    // Review point 2: health checks (update runs)
    previous_data = null
    full_health_check = false


    wf {
          example_cmd = []
          agent = null
          container = "articnetworkorg/bdbv-genepi"
          // Until releases are tagged this tracks the latest image. At release time change this to
          // manifest.version so each release pins (and pulls) the image built for its own tag.
          container_version = "1.0.10"
        }
}


manifest {
    name            = 'artic-nework/bdbv-genepi-nf'
    author          = 'Jonathan Pekar'
    homePage        = 'https://github.com/artic-network/bdbv-genepi-nf/'
    description     = 'Automated pipeline for downloading and cleaning Bundibugyo ebolavirus (BDBV) genome sequences hosted on Pathoplexus ready for phylogenetic analysis.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.10'
}

executor {
    $local {
        // the CPUs of the machine running the pipeline
        cpus = Runtime.runtime.availableProcessors()
        // no memory setting: Docker's own memory limit is the cap, so retries can ask for more
    }
}

// used by default for "standard" (docker) and singularity profiles,
// other profiles may override.
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    container = "${params.wf.container}:${params.wf.container_version}"

    // Explicit run-time limits per task (Nextflow stops a task that runs longer). They are far above normal
    // run times (most steps take seconds, an IQ-TREE run minutes) so only a stuck task reaches them, while
    // slow machines (emulation, few CPUs) are not cut off. Each retry gets a proportionally longer limit.
    time = { 6.h * task.attempt }
    withName: 'download'        { time = { 2.h * task.attempt } }
    withName: 'mafft|iqtree.*'  { time = { 24.h * task.attempt } }

    // A failed task (including one stopped for running too long, or killed by Docker) is retried up to
    // maxRetries times before the run stops; the other running tasks are allowed to finish first.
    maxRetries = 2
    errorStrategy = { task.attempt <= process.maxRetries ? 'retry' : 'finish' }

    // Memory is requested per task and grows with each retry (a task killed for lack of memory is retried
    // with more). The largest step uses under 2 GB. Docker's own memory setting is the real cap.
    memory = { 4.GB * task.attempt }

    // Output layout: one subfolder of outdir per step, numbered in the order of the main flow (to_review and execution are not numbered)
    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1]}" }, mode: params.publish_dir_mode]
    withName: 'download'          { publishDir = [path: "${params.outdir}/00_download", mode: params.publish_dir_mode] }
    // The alignment-preparation chain (MAFFT, cleaned, pre-filtered) is published together in 01_clean
    withName: 'mafft|pre_filter'  { publishDir = [path: "${params.outdir}/01_clean", mode: params.publish_dir_mode] }
    withName: 'clean' {
        publishDir = [
            [path: "${params.outdir}/01_clean", mode: params.publish_dir_mode, saveAs: { fn -> fn == 'missing_aliases.txt' ? null : fn }],
            [path: "${params.outdir}/to_review", mode: params.publish_dir_mode, pattern: 'missing_aliases.txt']
        ]
    }
    withName: 'qc_basic|qc_phylo' { publishDir = [path: "${params.outdir}/to_review", mode: params.publish_dir_mode] }
    withName: 'iqtree_ancestral'  { publishDir = [path: "${params.outdir}/02_iqtree_initial", mode: params.publish_dir_mode] }
    withName: 'raccoon'           { publishDir = [path: "${params.outdir}/03_raccoon", mode: params.publish_dir_mode, saveAs: { fn -> fn.replace("raccoon_output/", "") }] }
    withName: 'adar_mask'         { publishDir = [path: "${params.outdir}/04_adar", mode: params.publish_dir_mode] }
    withName: 'iqtree_adar'       { publishDir = [path: "${params.outdir}/05_iqtree_adar", mode: params.publish_dir_mode] }
    withName: 'temporal_root|select_outliers' { publishDir = [path: "${params.outdir}/06_temporal_root", mode: params.publish_dir_mode] }
    withName: 'filter_outliers|iqtree_final|final_root' { publishDir = [path: "${params.outdir}/07_final", mode: params.publish_dir_mode] }
    withName: 'metadata_quality_report|merge_exclude' { publishDir = [path: "${params.outdir}/to_review", mode: params.publish_dir_mode] }
    withName: 'health_checks|compare_runs' { publishDir = [path: "${params.outdir}/08_health_checks", mode: params.publish_dir_mode] }

    withName: 'iqtree_final' {
        ext.args = '-abayes'
    }
    withName: 'temporal_root' {
        ext.args = '--iterate'
    }
}


profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
        // IQ-TREE's arm64 build uses a slower SIMD kernel (SSE2) than its amd64 build (AVX+FMA), so on Apple
        // Silicon the amd64 image, run through Docker Desktop's Rosetta emulation, finishes about 1.6-3x sooner.
        // Intel Macs, Windows and Linux already get amd64 natively; Linux arm64 servers keep their native image.
        process.containerOptions = (params.container_platform ?: 'auto') == 'native' ? '' :
            (params.container_platform ?: 'auto') != 'auto' ? "--platform ${params.container_platform}" :
            (System.getProperty('os.name') == 'Mac OS X' && System.getProperty('os.arch') in ['aarch64', 'arm64']) ? '--platform linux/amd64' : ''
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }


    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }
}


timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/trace.txt"
  // workdir and process are used to build the combined run log (lib/RunLog.groovy)
  fields = 'task_id,hash,native_id,process,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir,attempt,memory,time'
}

env {
	PYTHONNOUSERSITE = 1
}
