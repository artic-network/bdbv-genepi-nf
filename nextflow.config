params {
    // Boilerplate options
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = false

    // Inputs (leave fasta unset to download from Pathoplexus)
    fasta = null
    metadata = null
    outdir = "output"
    output_intermediates = true
    run_name = new java.util.Date().format('yyyyMMdd')
    prefix = "bdbv_${params.run_name}"
    organism = "ebola-bdbv"
    scope = "drc"
    max_date = null
    aliases_file = "${projectDir}/data/aliases.csv"
    exclude_file = "${projectDir}/data/exclude.txt"
    mask_sites = null
    mask_sites_file = "${projectDir}/data/mask_sites.txt"
    exclude_pending = "${projectDir}/data/exclude_pending.txt"

    // Tree building
    mafft = false
    trim_start = 47
    trim_end = 18851
    min_date = null
    model = null
    seed = 42
    adar_mode = "mask"

    // Review point 1: outliers
    outlier_removal_threshold = null
    outlier_file = null

    // Review point 2: health checks (update runs)
    previous_data = null
    full_health_check = false


    wf {
          example_cmd = []
          agent = null
          container = "articnetworkorg/bdbv-genepi"
          // Until releases are tagged this tracks the latest image. At release time change this to
          // manifest.version so each release pins (and pulls) the image built for its own tag.
          container_version = "1.0.5"
        }
}


manifest {
    name            = 'artic-nework/bdbv-genepi-nf'
    author          = 'Jonathan Pekar'
    homePage        = 'https://github.com/artic-network/bdbv-genepi-nf/'
    description     = 'Automated pipeline for downloading and cleaning Bundibugyo ebolavirus (BDBV) genome sequences hosted on Pathoplexus ready for phylogenetic analysis.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.5'
}

executor {
    $local {
        cpus = 8
        memory = "8 GB"
    }
}

// used by default for "standard" (docker) and singularity profiles,
// other profiles may override.
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    container = "${params.wf.container}:${params.wf.container_version}"

    // Output layout: one subfolder of outdir per step
    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1]}" }, mode: params.publish_dir_mode]
    withName: 'download'          { publishDir = [path: "${params.outdir}/download", mode: params.publish_dir_mode] }
    withName: 'mafft'             { publishDir = [path: "${params.outdir}/intermediates", mode: params.publish_dir_mode, enabled: params.output_intermediates] }
    withName: 'pre_filter'        { publishDir = [path: "${params.outdir}/intermediates", mode: params.publish_dir_mode, enabled: params.output_intermediates] }
    withName: 'clean' {
        publishDir = [
            [path: "${params.outdir}/clean", mode: params.publish_dir_mode, saveAs: { fn -> fn == 'missing_aliases.txt' ? null : fn }],
            [path: "${params.outdir}/to_review", mode: params.publish_dir_mode, pattern: 'missing_aliases.txt']
        ]
    }
    withName: 'qc_basic|qc_phylo' { publishDir = [path: "${params.outdir}/to_review", mode: params.publish_dir_mode] }
    withName: 'iqtree_ancestral'  { publishDir = [path: "${params.outdir}/iqtree_initial", mode: params.publish_dir_mode] }
    withName: 'raccoon'           { publishDir = [path: "${params.outdir}/raccoon", mode: params.publish_dir_mode, saveAs: { fn -> fn.replace("raccoon_output/", "") }] }
    withName: 'adar_mask'         { publishDir = [path: "${params.outdir}/adar", mode: params.publish_dir_mode] }
    withName: 'iqtree_adar'       { publishDir = [path: "${params.outdir}/iqtree_adar", mode: params.publish_dir_mode] }
    withName: 'temporal_root|select_outliers' { publishDir = [path: "${params.outdir}/temporal_root", mode: params.publish_dir_mode] }
    withName: 'filter_outliers|iqtree_final|final_root' { publishDir = [path: "${params.outdir}/final", mode: params.publish_dir_mode] }
    withName: 'health_checks'     { publishDir = [path: "${params.outdir}/health_checks", mode: params.publish_dir_mode] }

    withName: 'mafft|iqtree.*' {
        cpus = 4
    }
    withName: 'iqtree_final' {
        ext.args = '-abayes'
    }
    withName: 'temporal_root' {
        ext.args = '--iterate'
    }
}


profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }


    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }
}


timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/trace.txt"
  // workdir and process are used to build the combined run log (lib/RunLog.groovy)
  fields = 'task_id,hash,native_id,process,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'
}

env {
	PYTHONNOUSERSITE = 1
}
