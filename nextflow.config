params {
    // Boilerplate options
    publish_dir_mode           = 'copy'
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = false

    // Inputs (leave fasta unset to download from Pathoplexus)
    fasta = null
    metadata = null
    outdir = "output"
    prefix = "bdbv-pipeline"
    run_name = new java.util.Date().format('yyyyMMdd')
    organism = "ebola-bdbv"
    scope = "drc"
    aliases_file = "${projectDir}/data/aliases.csv"
    exclude_file = "${projectDir}/data/exclude_identity.txt"
    exclude_quality = "${projectDir}/data/exclude_quality.txt"
    exclude_pending = "${projectDir}/data/exclude_pending.txt"

    // Tree building
    mafft = false
    trim_start = null
    trim_end = null
    min_date = null
    model = null
    seed = 42
    adar_mode = "mask"

    // Review point 1: outliers
    outlier_removal_threshold = null
    outlier_file = null

    // Review point 2: health checks (update runs)
    previous_data = null
    full_health_check = false
    stop_after_health_checks = false

    // BEAST XMLs
    beast_xml = true
    template_egc = "${projectDir}/templates/GTR_EGC.template.xml"
    template_sg = "${projectDir}/templates/GTR_SG.template.xml"
    template_lgc = null
    anchor_date = "2025-11-08"
    chain_length = null
    log_every = null

    wf {
          example_cmd = []
          agent = null
          container = "articnetworkorg/bdbv-pipeline"
          // Until releases are tagged this tracks the latest image. At release time change this to
          // manifest.version so each release pins (and pulls) the image built for its own tag.
          container_version = "latest"
        }
}


manifest {
    name            = 'pekarj/bdbv-pipeline-temp'
    author          = 'Jonathan Pekar'
    homePage        = 'https://github.com/pekarj/bdbv-pipeline-temp/'
    description     = 'Automated pipeline for downloading, cleaning, and building maximum-likelihood phylogenies from Bundibugyo ebolavirus (BDBV) genome sequences hosted on Pathoplexus.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

executor {
    $local {
        cpus = 8
        memory = "8 GB"
    }
}

// used by default for "standard" (docker) and singularity profiles,
// other profiles may override.
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    container = "${params.wf.container}:${params.wf.container_version}"

    withName: 'mafft|iqtree.*' {
        cpus = 4
    }
    withName: 'iqtree_final' {
        ext.args = '-abayes'
    }
    withName: 'temporal_root' {
        ext.args = '--iterate'
    }
}


profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
    }


    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }
}


timeline {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/timeline.html"
}
report {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/report.html"
}
trace {
  enabled = true
  overwrite = true
  file = "${params.outdir}/execution/trace.txt"
}

env {
	PYTHONNOUSERSITE = 1
}
